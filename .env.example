# LearnerCraft Environment Variables
# Copy this file to .env and fill in your values

# === Supabase (existing — for resource storage) ===
VITE_SUPABASE_URL="your_supabase_url"
VITE_SUPABASE_ANON_KEY="your_supabase_anon_key"

# === Google Gemini AI ===
VITE_GEMINI_API_KEY="your_gemini_api_key"

# === Firebase (create project at https://console.firebase.google.com) ===
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# === Optional: Additional AI Providers (all free tier) ===
# VITE_GROQ_API_KEY=""        # Get from https://console.groq.com
# VITE_CEREBRAS_API_KEY=""    # Get from https://cloud.cerebras.ai
# VITE_MISTRAL_API_KEY=""     # Get from https://console.mistral.ai
